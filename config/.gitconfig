[user]
	name = muyuu
	email = anticyborg@gmail.com
[ghq]
	root = ~/workspaces
[alias]
	delete-merged-branches = !git branch --merged | grep -v \\* | xargs -I % git branch -d %
[filter "lfs"]
	process = git-lfs filter-process
	# git-lfs を宣言していないので、無い環境で git 操作ごと失敗しないようにする
	required = false
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	editor = vi
	autocrlf = input
	eol = lf
# clone/fetch は HTTPS のまま・push だけ SSH に寄せる（insteadOf にすると Homebrew 等の
# 匿名 HTTPS fetch まで SSH 化され、鍵未設定の環境で壊れるため pushInsteadOf を使う）
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
[init]
	defaultBranch = main
# overlay が ~/.gitconfig.local を提供すれば業務メール等の上書きを取り込む（無ければ git が無視）
[include]
	path = ~/.gitconfig.local
